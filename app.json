{
  "expo": {
    "name": "TankerPlan",
    "slug": "tankerplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hpirselim.tankerplan",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hpirselim.tankerplan",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "TankerPlan",
      "shortName": "TankerPlan",
      "themeColor": "#111111",
      "backgroundColor": "#111111",
      "display": "standalone"
    },
    "experiments": {
      "baseUrl": "/Tankerplan"
    },
    "extra": {
      "eas": {
        "projectId": "36445de8-9870-4b28-8328-b25ab70f1deb"
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}